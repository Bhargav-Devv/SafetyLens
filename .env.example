# IBM watsonx.ai credentials for the Bob conversational layer.
#
#   copy this file to .env and fill it in       (.env is gitignored)
#   python main.py bob --llm
#
# Nothing here is ever logged or printed. If .env is absent, `main.py bob`
# still runs the deterministic agent, which needs no credentials at all.

# watsonx.ai -> Access (IAM) -> API keys -> Create
WATSONX_API_KEY=

# watsonx.ai -> Projects -> your project -> Manage -> General -> Project ID
WATSONX_PROJECT_ID=

# The regional endpoint your project lives in. One of:
#   https://us-south.ml.cloud.ibm.com
#   https://eu-de.ml.cloud.ibm.com
#   https://eu-gb.ml.cloud.ibm.com
#   https://jp-tok.ml.cloud.ibm.com
#   https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional. Must be a model that supports tool calling.
# Good choices: ibm/granite-3-8b-instruct, mistralai/mistral-large
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
